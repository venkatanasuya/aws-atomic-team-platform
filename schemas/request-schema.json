{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic Team S3 Request",
  "type": "object",
  "required": [
    "request_id",
    "resource_type",
    "team_name",
    "team_owner",
    "application_name",
    "environment",
    "project",
    "cost_center",
    "region",
    "bucket_suffix",
    "purpose"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "resource_type": {
      "const": "s3_bucket"
    },
    "team_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,32}$"
    },
    "team_owner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "application_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,40}$"
    },
    "environment": {
      "enum": [
        "dev",
        "test",
        "stage",
        "prod"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,40}$"
    },
    "cost_center": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{2,24}$"
    },
    "region": {
      "enum": [
        "us-east-1"
      ]
    },
    "bucket_suffix": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,30}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    }
  },
  "additionalProperties": false
}
